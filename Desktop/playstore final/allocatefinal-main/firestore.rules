rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Secure job seeker resume drafts
    match /job_seeker_resume_drafts/{userKey} {
      allow read, write: if request.auth != null && request.auth.uid == userKey;
      
      match /drafts/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userKey;
      }
    }
  }
}
