# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Setting (Point to frontend URL in production)
FRONTEND_URL=https://sayuka.in

# Admin Authentication (Required in Production)
# Configure these on your host server environment variables (e.g. on Hostinger)
ADMIN_USERNAME=your_secure_username
ADMIN_PASSWORD_HASH=your_secure_bcrypt_password_hash
JWT_SECRET=your_secure_jwt_random_secret_key

# Database Connection (Required in Production)
# Hostinger Business/Cloud MySQL database parameters
DB_HOST=localhost
DB_USER=your_hostinger_db_username
DB_PASSWORD=your_hostinger_db_password
DB_NAME=your_hostinger_db_name

# WhatsApp Business API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_TEMPLATE_NAMESPACE=your_whatsapp_template_namespace

# Cashfree Payment Gateway Configuration
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=sandbox
